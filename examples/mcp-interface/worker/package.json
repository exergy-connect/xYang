{
  "name": "xyang-mcp-topology-worker",
  "private": true,
  "type": "module",
  "scripts": {
    "model": "cd .. && node ../../ts/dist/cli.js convert --include-path models models/example-topology-tools@2026-11-11.yang > out/example-topology-tools.yang.json",
    "dev": "wrangler dev --ip 127.0.0.1 --port 8787",
    "check": "tsc --noEmit && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@exergy-connect/xyang": "file:../../../ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5",
    "typescript": "^5",
    "wrangler": "^4"
  }
}
