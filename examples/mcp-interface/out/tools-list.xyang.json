{
  "tools": [
    {
      "name": "add-node",
      "description": "Add a node to the topology.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/node-name",
            "description": "Name of the new node. Unique in the topology.",
            "x-yang": {
              "type": "leaf",
              "must": [
                {
                  "must": "not(/topo:session/topo:call[derived-from-or-self(tool, 'topo:add-node')][result/status = 'ok'][arguments/add-node/name = current()][not(current()/../../../id) or id < current()/../../../id]) or current()/../../../result/status = 'error'",
                  "error-message": "A node with this name already exists.",
                  "xpath-prefixes": {
                    "topo": "example-topology-tools"
                  }
                }
              ],
              "mandatory": true
            }
          },
          "role": {
            "type": "string",
            "enum": [
              "router",
              "switch",
              "host"
            ],
            "description": "What the node does.",
            "x-yang": {
              "type": "leaf"
            },
            "default": "router"
          }
        },
        "required": [
          "name"
        ],
        "$defs": {
          "node-name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "x-yang": {
              "string-patterns": [
                {
                  "pattern": "[a-z][a-z0-9-]{0,31}",
                  "invert-match": false
                }
              ]
            },
            "description": "Lowercase node name, 1 to 32 characters."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "$ref": "#/$defs/node-name",
            "description": "Name of the node that was added.",
            "x-yang": {
              "type": "leaf"
            }
          }
        },
        "$defs": {
          "node-name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "x-yang": {
              "string-patterns": [
                {
                  "pattern": "[a-z][a-z0-9-]{0,31}",
                  "invert-match": false
                }
              ]
            },
            "description": "Lowercase node name, 1 to 32 characters."
          }
        }
      }
    },
    {
      "name": "add-link",
      "description": "Connect two existing nodes with a link.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/$defs/node-name",
            "description": "One end of the link.",
            "x-yang": {
              "type": "leaf",
              "must": [
                {
                  "must": "/topo:session/topo:call[derived-from-or-self(tool, 'topo:add-node')][result/status = 'ok'][arguments/add-node/name = current()][not(current()/../../../id) or id < current()/../../../id]",
                  "error-message": "source must name a node that an earlier successful add-node call created.",
                  "xpath-prefixes": {
                    "topo": "example-topology-tools"
                  }
                }
              ],
              "mandatory": true
            }
          },
          "target": {
            "$ref": "#/$defs/node-name",
            "description": "The other end of the link. Must differ from source.",
            "x-yang": {
              "type": "leaf",
              "must": [
                {
                  "must": ". != ../source",
                  "error-message": "A link cannot connect a node to itself."
                },
                {
                  "must": "/topo:session/topo:call[derived-from-or-self(tool, 'topo:add-node')][result/status = 'ok'][arguments/add-node/name = current()][not(current()/../../../id) or id < current()/../../../id]",
                  "error-message": "target must name a node that an earlier successful add-node call created.",
                  "xpath-prefixes": {
                    "topo": "example-topology-tools"
                  }
                }
              ],
              "mandatory": true
            }
          },
          "bandwidth-mbps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 400000,
            "description": "Link capacity in megabits per second.",
            "x-yang": {
              "type": "leaf"
            },
            "default": 1000
          }
        },
        "required": [
          "source",
          "target"
        ],
        "$defs": {
          "node-name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "x-yang": {
              "string-patterns": [
                {
                  "pattern": "[a-z][a-z0-9-]{0,31}",
                  "invert-match": false
                }
              ]
            },
            "description": "Lowercase node name, 1 to 32 characters."
          }
        }
      }
    },
    {
      "name": "find-path",
      "description": "Find a path between two nodes, as a list of hops.",
      "inputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "from": {
            "$ref": "#/$defs/node-name",
            "description": "Start node.",
            "x-yang": {
              "type": "leaf",
              "must": [
                {
                  "must": "/topo:session/topo:call[derived-from-or-self(tool, 'topo:add-node')][result/status = 'ok'][arguments/add-node/name = current()][not(current()/../../../id) or id < current()/../../../id]",
                  "error-message": "from must name a node that an earlier successful add-node call created.",
                  "xpath-prefixes": {
                    "topo": "example-topology-tools"
                  }
                }
              ],
              "mandatory": true
            }
          },
          "to": {
            "$ref": "#/$defs/node-name",
            "description": "End node.",
            "x-yang": {
              "type": "leaf",
              "must": [
                {
                  "must": "/topo:session/topo:call[derived-from-or-self(tool, 'topo:add-node')][result/status = 'ok'][arguments/add-node/name = current()][not(current()/../../../id) or id < current()/../../../id]",
                  "error-message": "to must name a node that an earlier successful add-node call created.",
                  "xpath-prefixes": {
                    "topo": "example-topology-tools"
                  }
                }
              ],
              "mandatory": true
            }
          },
          "max-hops": {
            "type": "integer",
            "minimum": 1,
            "maximum": 16,
            "description": "Longest path to consider, in hops.",
            "x-yang": {
              "type": "leaf"
            },
            "default": 8
          }
        },
        "required": [
          "from",
          "to"
        ],
        "$defs": {
          "node-name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "x-yang": {
              "string-patterns": [
                {
                  "pattern": "[a-z][a-z0-9-]{0,31}",
                  "invert-match": false
                }
              ]
            },
            "description": "Lowercase node name, 1 to 32 characters."
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "hop": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/node-name"
            },
            "description": "Nodes on the path, from 'from' to 'to'.",
            "x-yang": {
              "type": "leaf-list",
              "must": [
                {
                  "must": "/topo:session/topo:call[derived-from-or-self(tool, 'topo:add-node')][result/status = 'ok'][arguments/add-node/name = current()][not(current()/../../../id) or id < current()/../../../id]",
                  "error-message": "Every hop must be a node that an earlier successful add-node call created.",
                  "xpath-prefixes": {
                    "topo": "example-topology-tools"
                  }
                }
              ]
            }
          }
        },
        "$defs": {
          "node-name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,31}$",
            "x-yang": {
              "string-patterns": [
                {
                  "pattern": "[a-z][a-z0-9-]{0,31}",
                  "invert-match": false
                }
              ]
            },
            "description": "Lowercase node name, 1 to 32 characters."
          }
        }
      }
    }
  ]
}
