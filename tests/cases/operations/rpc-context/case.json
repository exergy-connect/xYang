{
  "description": "RFC 7950 §6.4.1: the accessible tree is the operation node plus the server data given as context. Absolute and relative leafref and must reach both. Without context, references outside the operation are unresolved.",
  "module": "m.yang",
  "instances": [
    { "name": "references resolve in context", "rpc": "add-link",
      "context": { "m:topology": { "node": [{ "name": "r1", "up": true }, { "name": "r2" }] } },
      "data": { "m:input": { "source": "r1", "target": "r2", "peer": "r1", "via": "r2", "label": "x" } }, "valid": true },
    { "name": "dangling leafref", "rpc": "add-link",
      "context": { "m:topology": { "node": [{ "name": "r1" }] } },
      "data": { "m:input": { "source": "r1", "target": "r9" } }, "valid": false,
      "errors": [{ "path": "/m:input/target", "code": "leafref" }] },
    { "name": "no context: absolute leafrefs are unresolved", "rpc": "add-link",
      "data": { "m:input": { "source": "r1", "target": "r2" } }, "valid": false,
      "errors": [{ "path": "/m:input/source", "code": "leafref" }, { "path": "/m:input/target", "code": "leafref" }] },
    { "name": "empty context behaves like no context", "rpc": "add-link", "context": {},
      "data": { "m:input": { "source": "r1", "target": "r2" } }, "valid": false,
      "errors": [{ "path": "/m:input/source", "code": "leafref" }, { "path": "/m:input/target", "code": "leafref" }] },
    { "name": "require-instance false needs no context", "rpc": "add-link",
      "context": { "m:topology": { "node": [{ "name": "r1" }, { "name": "r2" }] } },
      "data": { "m:input": { "source": "r1", "target": "r2", "backup": "nowhere" } }, "valid": true },
    { "name": "relative leafref inside the operation", "rpc": "add-link",
      "context": { "m:topology": { "node": [{ "name": "r1" }, { "name": "r2" }] } },
      "data": { "m:input": { "source": "r1", "target": "r2", "peer": "r2" } }, "valid": false,
      "errors": [{ "path": "/m:input/peer", "code": "leafref" }] },
    { "name": "absolute must on the operation node", "rpc": "add-link",
      "context": { "m:topology": { "node": [{ "name": "r1" }, { "name": "r2" }] } },
      "data": { "m:input": { "source": "r1", "target": "r2", "via": "r1" } }, "valid": false,
      "errors": [{ "path": "/m:input/via", "code": "must", "message": "A link cannot go via its own source." }] },
    { "name": "must reads server data", "rpc": "add-link",
      "context": { "m:topology": { "node": [{ "name": "r1", "up": false }, { "name": "r2" }] } },
      "data": { "m:input": { "source": "r1", "target": "r2", "label": "x" } }, "valid": false,
      "errors": [{ "path": "/m:input/label", "code": "must", "message": "The source node must be up." }] },
    { "name": "must without context is false", "rpc": "add-link",
      "data": { "m:input": { "source": "r1", "target": "r2", "label": "x" } }, "valid": false,
      "errors": [
        { "path": "/m:input/source", "code": "leafref" },
        { "path": "/m:input/target", "code": "leafref" },
        { "path": "/m:input/label", "code": "must", "message": "The source node must be up." }
      ] },
    { "name": "output leafref against context", "rpc": "add-link", "direction": "output",
      "context": { "m:topology": { "node": [{ "name": "r1" }] } },
      "data": { "m:output": { "node": "r1" } }, "valid": true },
    { "name": "output dangling leafref without context", "rpc": "add-link", "direction": "output",
      "data": { "m:output": { "node": "r1" } }, "valid": false,
      "errors": [{ "path": "/m:output/node", "code": "leafref" }] },
    { "name": "native JSON context", "rpc": "add-link", "encoding": "native",
      "context": { "topology": { "node": [{ "name": "r1" }, { "name": "r2" }] } },
      "data": { "source": "r1", "target": "r9" }, "valid": false,
      "errors": [{ "path": "/target", "code": "leafref" }] },
    { "name": "context is not an object", "rpc": "add-link", "context": [],
      "data": { "m:input": {} }, "usage_error": "context must be a JSON object" },
    { "name": "context is not instance data", "rpc": "add-link", "context": { "m:topology": { "node": "r1" } },
      "data": { "m:input": {} }, "usage_error": "context is not valid instance data" }
  ]
}
