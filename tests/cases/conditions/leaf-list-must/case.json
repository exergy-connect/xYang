{
  "description": "must on a leaf-list evaluates per element with current() bound to each value; relative paths reach sibling leaves; empty leaf-lists skip must.",
  "module": "m.yang",
  "instances": [
    { "name": "all elements satisfied",
      "data": { "data": { "min_value": 10, "single_value": 5, "values": [10, 15, 20, 100] } },
      "valid": true },
    { "name": "negative element",
      "data": { "data": { "min_value": 10, "single_value": 5, "values": [10, -1, 20] } },
      "valid": false,
      "errors": [{ "path": "/data/values/1", "code": "must" }] },
    { "name": "zero element",
      "data": { "data": { "min_value": 0, "single_value": 5, "values": [1, 0, 2] } },
      "valid": false,
      "errors": [{ "path": "/data/values/1", "code": "must" }] },
    { "name": "above max",
      "data": { "data": { "min_value": 0, "single_value": 5, "values": [10, 150, 20] } },
      "valid": false,
      "errors": [{ "path": "/data/values/1", "code": "must" }] },
    { "name": "below min_value",
      "data": { "data": { "min_value": 10, "single_value": 5, "values": [10, 5, 20] } },
      "valid": false,
      "errors": [{ "path": "/data/values/1", "code": "must" }] },
    { "name": "empty leaf-list",
      "data": { "data": { "min_value": 10, "single_value": 5, "values": [] } },
      "valid": true },
    { "name": "single element ok",
      "data": { "data": { "min_value": 0, "single_value": 5, "values": [50] } },
      "valid": true },
    { "name": "single element bad",
      "data": { "data": { "min_value": 0, "single_value": 5, "values": [-1] } },
      "valid": false,
      "errors": [{ "path": "/data/values/0", "code": "must" }] },
    { "name": "leaf ok leaf-list bad",
      "data": { "data": { "min_value": 0, "single_value": 5, "values": [1, -1, 3] } },
      "valid": false,
      "errors": [{ "path": "/data/values/1", "code": "must" }] }
  ]
}
