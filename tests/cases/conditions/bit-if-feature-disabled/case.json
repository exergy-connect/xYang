    { "name": "unguarded bit", "data": { "top": { "flags": "read" } }, "valid": true },
    { "name": "guarded bit", "data": { "top": { "flags": "write" } }, "valid": false,
      "errors": [{ "path": "/top/flags", "code": "if-feature" }] },
    { "name": "guarded bit with another", "data": { "top": { "flags": "read write" } }, "valid": false,
      "errors": [{ "path": "/top/flags", "code": "if-feature" }] }
  ]
