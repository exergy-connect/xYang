{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ext",
  "x-yang": {
    "module": "ext",
    "yang-version": "1.1",
    "namespace": "urn:ext",
    "prefix": "e",
    "organization": "",
    "contact": "",
    "imports": {
      "b": {
        "module": "base",
        "namespace": "urn:base",
        "prefix": "b",
        "identities": {
          "gadget": {
            "type": "string",
            "enum": [
              "b:gadget"
            ],
            "x-yang": {
              "type": "identity",
              "bases": [
