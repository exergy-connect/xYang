                  "type": "identityref",
                  "bases": [
                    "b:thing"
                  ]
                }
              },
              "args": {
                "type": "object",
                "x-yang": {
                  "type": "container"
                },
                "properties": {
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 255,
                    "x-yang": {
                      "type": "leaf"
                    }
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "x-yang": {
            "type": "list",
            "key": "id"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "widget": {
      "type": "string",
      "enum": [
        "e:widget"
      ],
      "x-yang": {
        "type": "identity",
        "bases": [
          "b:thing"
        ]
      }
    },
    "plain": {
      "type": "string",
      "enum": [
        "e:plain"
      ],
      "x-yang": {
        "type": "identity",
        "bases": []
      }
    }
  }
