              ]
            }
          },
          "thing": {
            "type": "string",
            "enum": [
              "b:gadget",
              "b:thing"
            ],
            "x-yang": {
              "type": "identity",
              "bases": []
            }
          }
        }
      }
    }
  },
  "type": "object",
