module m {
  yang-version 1.1;
  namespace "urn:m";
  prefix m;
  feature enabled;
  list item {
    key id;
    must "number(value) > 0";
    leaf id { type string; }
    leaf value { type int32; mandatory true; }
    leaf optional1 { type string; }
    leaf optional2 { type string; }
    leaf optional3 { type string; }
    leaf guarded { if-feature enabled; type string; }
    leaf conditional { when "../value > 1"; type string; }
    leaf-list required-list { type string; min-elements 1; }
  }
}
