{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m",
  "x-yang": {
    "module": "m",
    "yang-version": "1.1",
    "namespace": "urn:m",
    "prefix": "m",
    "organization": "",
    "contact": ""
  },
  "type": "object",
  "properties": {
    "a": {
      "type": "object",
      "x-yang": {
        "type": "container"
      },
      "properties": {
        "value": {
          "$ref": "#/$defs/~1a~1code",
          "x-yang": {
            "type": "leaf",
            "type-context": "/a"
          }
        },
        "child": {
          "type": "object",
          "x-yang": {
            "type": "container"
          },
          "properties": {
            "value": {
              "$ref": "#/$defs/~1a~1code",
              "x-yang": {
                "type": "leaf",
                "type-context": "/a/child"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "b": {
      "type": "object",
      "x-yang": {
        "type": "container"
      },
      "properties": {
        "value": {
          "$ref": "#/$defs/~1b~1code",
          "x-yang": {
            "type": "leaf",
            "type-context": "/b"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "/a/code": {
      "type": "string",
      "pattern": "^a+$",
      "x-yang": {
        "string-patterns": [
          {
            "pattern": "a+",
            "invert-match": false
          }
        ],
        "scope": "/a",
        "name": "code"
      }
    },
    "/b/code": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "x-yang": {
        "scope": "/b",
        "name": "code"
      }
    }
  }
}
