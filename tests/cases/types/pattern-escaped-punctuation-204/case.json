    { "name": "outside the class", "data": { "top": { "marks": "x" } }, "valid": false,
      "errors": [{ "path": "/top/marks", "code": "pattern" }] },
    { "name": "not the escaped literal", "data": { "top": { "coded": "a#bc" } }, "valid": false,
      "errors": [{ "path": "/top/coded", "code": "pattern" }] }
  ]
