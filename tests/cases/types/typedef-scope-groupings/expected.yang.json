{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:m",
  "x-yang": {
    "module": "m",
    "yang-version": "1.1",
    "namespace": "urn:m",
    "prefix": "m",
    "organization": "",
    "contact": ""
  },
  "type": "object",
  "properties": {
    "top": {
      "type": "object",
      "x-yang": {
        "type": "container"
      },
      "properties": {
        "first": {
          "$ref": "#/$defs/~1%40grouping%3Aa~1code",
          "x-yang": {
            "type": "leaf",
            "type-context": "/@grouping:a"
          }
        },
        "second": {
          "$ref": "#/$defs/~1%40grouping%3Ab~1code",
          "x-yang": {
            "type": "leaf",
            "type-context": "/@grouping:b"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "/@grouping:a/code": {
      "type": "string",
      "pattern": "^a+$",
      "x-yang": {
        "string-patterns": [
          {
            "pattern": "a+",
            "invert-match": false
          }
        ],
        "scope": "/@grouping:a",
        "name": "code"
      }
    },
    "/@grouping:b/code": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "x-yang": {
        "scope": "/@grouping:b",
        "name": "code"
      }
    }
  }
}
