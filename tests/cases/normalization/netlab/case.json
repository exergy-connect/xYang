{
  "description": "Netlab topology forms, AS inheritance, and link validation",
  "module": "../../../../examples/netlab/netlab.yang",
  "instances": [
    {
      "name": "mixed ibgp and ebgp topology",
      "encoding": "native",
      "data": {
        "defaults.sources.extra": [
          "../wait_times.yml"
        ],
        "defaults.paths.prepend.plugin": [
          "topology:../plugin"
        ],
        "defaults.interfaces.mtu": 1500,
        "module": [
          "bgp",
          "ospf"
        ],
        "plugin": [
          "bgp.session",
          "adjust_test"
        ],
        "bgp.as": 65000,
        "ospf.timers.hello": 1,
        "ospf.timers.dead": 3,
        "_adjust": [
          {
            "nodes": [
              "dut"
            ],
            "features": [
              "ospf.timers"
            ],
            "remove": [
              "nodes:ospf.timers"
            ]
          }
        ],
        "groups": {
          "probes": {
            "device": "frr",
            "provider": "clab",
            "members": [
              "x1",
              "x2"
            ]
          }
        },
        "nodes": {
          "dut": null,
          "x1": {
            "bgp.passive": true,
            "bgp.session.apply.ibgp": [
              "passive"
            ]
          },
          "x2": {
            "bgp.as": 65100,
            "loopback.ipv4": "172.42.42.1/24",
            "module": [
              "bgp"
            ]
          }
        },
        "links": [
          {
            "dut": null,
            "x1": null
          },
          "dut-x2"
        ],
        "validate": {
          "ospf_adj": {
            "nodes": [
              "x1"
            ],
            "wait": "ospfv2_adj_p2p",
            "plugin": "ospf_neighbor(x)",
            "stop_on_error": true
          }
        }
      },
      "valid": true
    },
