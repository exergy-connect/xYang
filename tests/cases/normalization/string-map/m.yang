module m {
  yang-version 1.1;
  namespace "urn:normalization-string-map";
  prefix m;
  import xyang-transform { prefix xt; }

  list inventory {
    key name;
    leaf name { type string; }
  }
  list connections {
    config false;
    xt:normalize {
      xt:if 'type == "string"' {
        xt:apply 'map(split("-"), members: {id: $value})';
      }
    }
    list members {
      key id;
      min-elements 1;
      leaf id { type leafref { path "/inventory/name"; } }
    }
  }
  container unconditional {
    presence "Only when supplied";
    xt:normalize {
      xt:apply 'map(split("-"), members: {id: $value})';
    }
    list members {
      key id;
      min-elements 1;
      leaf id { type leafref { path "/inventory/name"; } }
    }
  }
  container characters {
    presence "Only when supplied";
    xt:normalize {
      xt:if 'type == "string"' {
        xt:apply 'map(split(""), items: {value: $value})';
      }
    }
    list items {
      key value;
      min-elements 3;
      max-elements 3;
      leaf value { type string; }
    }
  }
}
