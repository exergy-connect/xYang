    { "name": "implicit case", "data": { "top": { "unix-path": "/tmp/s" } }, "valid": true },
    { "name": "no case", "data": { "top": {} }, "valid": true },
    { "name": "two cases", "data": { "top": { "port": 80, "dgram-port": 53 } }, "valid": false,
      "errors": [{ "path": "/top", "code": "choice-multiple-cases" }] },
    { "name": "type error inside active case", "data": { "top": { "port": 70000 } }, "valid": false,
      "errors": [{ "path": "/top/port", "code": "range" }] }
  ]
