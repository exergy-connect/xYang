      "errors": [{ "path": "/top/name", "code": "must" }] },
    { "name": "rest after first dash", "data": { "top": { "multi": "a-b-c" } }, "valid": true },
    { "name": "shorter rest", "data": { "top": { "multi": "a-b" } }, "valid": false,
      "errors": [{ "path": "/top/multi", "code": "must" }] },
    { "name": "no occurrence", "data": { "top": { "name": "ab" } }, "valid": false,
      "errors": [{ "path": "/top/name", "code": "must" }] },
    { "name": "empty source", "data": { "top": { "name": "" } }, "valid": false,
      "errors": [{ "path": "/top/name", "code": "must" }] },
    { "name": "empty needle", "data": { "top": { "empty-needle": "" } }, "valid": true },
    { "name": "empty needle on text", "data": { "top": { "empty-needle": "a-b" } }, "valid": true },
    { "name": "needle absent", "data": { "top": { "no-match": "abc" } }, "valid": true },
    { "name": "needle absent on empty", "data": { "top": { "no-match": "" } }, "valid": true },
    { "name": "missing args", "data": { "top": { "missing": "a-b" } }, "valid": false,
