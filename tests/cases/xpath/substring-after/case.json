    { "name": "one arg", "data": { "top": { "one-arg": "a-b" } }, "valid": false,
      "errors": [{ "path": "/top/one-arg", "code": "xpath-error" }] },
    { "name": "extra arg", "data": { "top": { "extra": "a-b" } }, "valid": false,
      "errors": [{ "path": "/top/extra", "code": "xpath-error" }] },
    { "name": "non-string", "data": { "top": { "qty": 123 } }, "valid": true },
    { "name": "non-string miss", "data": { "top": { "qty": 12 } }, "valid": false,
      "errors": [{ "path": "/top/qty", "code": "must" }] },
    { "name": "numeric literal", "data": { "top": { "literal": "ok" } }, "valid": true }
