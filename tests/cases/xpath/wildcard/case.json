{
  "description": "XPath 1.0 NameTest '*' (RFC 7950 6.4, XPath 1.0 2.3 and 3.7) selects every data-node child of the context node: count(*), a predicate on the step, a step inside a path, list entries and leaf-list items counted individually, absence, a choice's children, and a '*' inside when.",
  "module": "m.yang",
  "instances": [
    { "name": "all constraints hold",
      "data": { "top": {
        "all": { "a": "x" },
        "filtered": { "p": { "v": "1" }, "q": {} },
        "deep": { "x": { "y": { "b": "1" }, "z": {} } },
        "counts": { "items": [{ "id": "i1" }, { "id": "i2" }], "tags": ["t"] },
        "empty": {},
        "gate": { "src": { "p": "1", "q": "2" }, "guarded": "g" },
        "pick": { "y": "1" } } },
      "valid": true },
    { "name": "count(*) with two children",
      "data": { "top": { "all": { "a": "x", "b": "y" } } },
      "valid": false, "errors": [{ "path": "/top/all", "code": "must" }] },
    { "name": "count(*) with no children",
      "data": { "top": { "all": {} } },
      "valid": false, "errors": [{ "path": "/top/all", "code": "must" }] },
    { "name": "wildcard step with a predicate",
      "data": { "top": { "filtered": { "p": { "v": "1" }, "q": { "v": "2" } } } },
      "valid": false, "errors": [{ "path": "/top/filtered", "code": "must" }] },
    { "name": "wildcard step inside a path",
      "data": { "top": { "deep": { "x": { "y": { "b": "1" }, "z": { "b": "2" } } } } },
      "valid": false, "errors": [{ "path": "/top/deep", "code": "must" }] },
    { "name": "list entries and leaf-list items are counted one by one",
      "data": { "top": { "counts": { "items": [{ "id": "i1" }], "tags": ["t"] } } },
      "valid": false, "errors": [{ "path": "/top/counts", "code": "must" }] },
    { "name": "leaf-list items add up",
      "data": { "top": { "counts": { "items": [{ "id": "i1" }], "tags": ["t", "u"] } } },
      "valid": true },
    { "name": "absence counts zero",
      "data": { "top": { "empty": { "a": "x" } } },
      "valid": false, "errors": [{ "path": "/top/empty", "code": "must" }] },
    { "name": "wildcard in when keeps the node",
      "data": { "top": { "gate": { "src": { "p": "1", "q": "2" }, "guarded": "g" } } },
      "valid": true },
    { "name": "wildcard in when rejects the node",
      "data": { "top": { "gate": { "src": { "p": "1" }, "guarded": "g" } } },
      "valid": false, "errors": [{ "path": "/top/gate/guarded", "code": "when" }] },
    { "name": "wildcard in when with the node absent",
      "data": { "top": { "gate": { "src": { "p": "1" } } } },
      "valid": true },
    { "name": "wildcard spans the cases of a choice",
      "data": { "top": { "pick": { "x": "1" } } },
      "valid": true }
  ]
}
