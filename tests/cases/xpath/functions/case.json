{
  "description": "Every XPath function both implementations support: boolean, concat, count, current, deref, derived-from, derived-from-or-self, false, not, number, string, string-length, translate, true.",
  "module": "m.yang",
  "instances": [
    { "name": "all satisfied", "data": { "top": { "name": "ab", "mode": "good", "label": "ab-x", "items": [{ "id": "1" }] } },
      "valid": true },
    { "name": "or rescues not()", "data": { "top": { "name": "ok", "mode": "bad" } }, "valid": true },
    { "name": "count()", "data": { "top": { "items": [{ "id": "1" }, { "id": "2" }, { "id": "3" }] } }, "valid": false,
      "errors": [{ "path": "/top", "code": "must" }] },
    { "name": "string-length()", "data": { "top": { "name": "abcdef" } }, "valid": false,
      "errors": [{ "path": "/top/name", "code": "must" }] },
    { "name": "not() and or", "data": { "top": { "name": "no", "mode": "bad" } }, "valid": false,
      "errors": [{ "path": "/top/mode", "code": "must" }] },
    { "name": "concat()", "data": { "top": { "name": "ab", "label": "ab-y" } }, "valid": false,
      "errors": [{ "path": "/top/label", "code": "must" }] },
    { "name": "boolean()", "data": { "top": { "flag": "x" } }, "valid": true },
    { "name": "boolean() false", "data": { "top": { "empty-flag": "z" } }, "valid": false,
      "errors": [{ "path": "/top/empty-flag", "code": "must" }] },
    { "name": "true()", "data": { "top": { "yes": true } }, "valid": true },
    { "name": "true() false", "data": { "top": { "yes": false } }, "valid": false,
      "errors": [{ "path": "/top/yes", "code": "must" }] },
    { "name": "false()", "data": { "top": { "no": false } }, "valid": true },
    { "name": "false() true", "data": { "top": { "no": true } }, "valid": false,
      "errors": [{ "path": "/top/no", "code": "must" }] },
    { "name": "current()", "data": { "top": { "anchor": "here" } }, "valid": true },
    { "name": "current() mismatch", "data": { "top": { "anchor": "there" } }, "valid": false,
      "errors": [{ "path": "/top/anchor", "code": "must" }] },
    { "name": "string()", "data": { "top": { "text": "ab" } }, "valid": true },
    { "name": "string() mismatch", "data": { "top": { "text": "xy" } }, "valid": false,
      "errors": [{ "path": "/top/text", "code": "must" }] },
    { "name": "number()", "data": { "top": { "qty": "3" } }, "valid": true },
    { "name": "number() mismatch", "data": { "top": { "qty": "4" } }, "valid": false,
      "errors": [{ "path": "/top/qty", "code": "must" }] },
    { "name": "translate()", "data": { "top": { "slug": "a_b" } }, "valid": true },
    { "name": "translate() mismatch", "data": { "top": { "slug": "a-b" } }, "valid": false,
      "errors": [{ "path": "/top/slug", "code": "must" }] },
    { "name": "deref()", "data": { "top": { "items": [{ "id": "k" }], "ref": "k" } }, "valid": true },
    { "name": "deref() mismatch", "data": { "top": { "items": [{ "id": "other" }], "ref": "other" } }, "valid": false,
      "errors": [{ "path": "/top/ref", "code": "must" }] },
    { "name": "derived-from()", "data": { "top": { "kind": "m:child" } }, "valid": true },
    { "name": "derived-from() self", "data": { "top": { "kind": "m:base" } }, "valid": false,
      "errors": [{ "path": "/top/kind", "code": "must" }] },
    { "name": "derived-from-or-self()", "data": { "top": { "kind-self": "m:child" } }, "valid": true },
    { "name": "derived-from-or-self() ancestor", "data": { "top": { "kind-self": "m:base" } }, "valid": false,
      "errors": [{ "path": "/top/kind-self", "code": "must" }] }
  ]
}
