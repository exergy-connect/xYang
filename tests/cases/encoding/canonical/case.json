        "links": [{ "nodes": [{ "node": "dut" }, { "node": "x9" }] }] },
      "valid": false,
      "errors": [{ "path": "/links/0/nodes/1/node", "code": "leafref" }] },
    { "name": "canonical instance, missing AS",
      "encoding": "native", "canonical": true,
