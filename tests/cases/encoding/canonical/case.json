{
  "description": "Issue #262: canonical (with native JSON) validates an instance already in the canonical form as written, with no projected copy. Canonical native JSON is the tree the encoder would build: members spelled as in that tree, lists as arrays, no dotted keys, no xt:normalize rule that would change a value. A false claim fails with only the canonical check's errors; it is not normalized or re-encoded. Without canonical, Netlab's dotted keys, keyed nodes and hyphen links still normalize. Pointers address the input as written.",
  "module": "../../../../examples/netlab/netlab.yang",
  "instances": [
    { "name": "official shape normalizes by default",
      "encoding": "native",
      "data": { "module": ["bgp"], "groups": { "probes": { "device": "frr", "provider": "clab", "members": ["x1"] } },
        "nodes": { "dut": { "bgp.as": 65000 }, "x1": { "bgp.as": 65100 } }, "links": ["dut-x1"] },
      "valid": true },
    { "name": "official shape, missing AS",
      "encoding": "native",
      "data": { "module": ["bgp"], "groups": { "probes": { "device": "frr", "provider": "clab", "members": ["x1"] } },
        "nodes": { "dut": { "bgp.as": 65000 }, "x1": null }, "links": ["dut-x1"] },
      "valid": false,
      "errors": [{ "path": "/nodes/x1", "code": "must", "message": "BGP is enabled but no node, topology, or default AS is set." }] },
    { "name": "canonical instance",
      "encoding": "native", "canonical": true,
      "data": { "module": ["bgp"], "groups": [{ "name": "probes", "device": "frr", "provider": "clab", "members": ["x1"] }],
        "nodes": [{ "name": "dut", "bgp": { "as": 65000 } }, { "name": "x1", "bgp": { "as": 65100 } }],
        "links": [{ "nodes": [{ "node": "dut" }, { "node": "x1" }] }] },
      "valid": true },
    { "name": "canonical instance, dangling link node",
      "encoding": "native", "canonical": true,
