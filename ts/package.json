{
  "name": "@exergy-connect/xyang",
  "version": "1.0.2",
  "description": "Parse YANG modules, validate RFC 7951 JSON instance data, and export JSON Schema — TypeScript library and xyang-ts CLI",
  "keywords": ["yang", "rfc7950", "rfc7951", "netconf", "restconf", "json-schema", "validation", "schema", "mcp", "agents"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/exergy-connect/xYang.git",
    "directory": "ts"
  },
  "bugs": {
    "url": "https://github.com/exergy-connect/xYang/issues"
  },
  "homepage": "https://github.com/exergy-connect/xYang#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": "./dist/index.umd.min.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./encoding": {
      "types": "./dist/encoding-entry.d.ts",
      "import": "./dist/encoding-entry.js",
      "default": "./dist/encoding-entry.js"
    },
    "./types": {
      "types": "./dist/types-entry.d.ts",
      "import": "./dist/types-entry.js",
      "default": "./dist/types-entry.js"
    },
    "./browser": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.browser.js",
      "default": "./dist/index.browser.js"
    }
  },
  "bin": {
    "xyang-ts": "dist/cli.js"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsdown && node ./scripts/build-browser-iife.mjs",
    "build:check": "npm run build && node ./scripts/check-artifacts.mjs && node ./scripts/sync-docs-browser-bundle.mjs",
    "build:ci": "node ./scripts/build-ci-artifacts.mjs && node ./scripts/check-ci-artifacts.mjs",
    "test": "vitest run --exclude test/ontology_audit_example.test.ts",
    "test:ontology": "vitest run test/ontology_audit_example.test.ts",
    "test:coverage": "vitest run --coverage --exclude test/ontology_audit_example.test.ts",
    "lint": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "bench": "node ./scripts/run-bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "esbuild": "^0.28.1",
    "tsdown": "^0.23.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
